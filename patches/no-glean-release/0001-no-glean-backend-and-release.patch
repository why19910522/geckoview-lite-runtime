+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at https://mozilla.org/MPL/2.0/.
+"""Generate only zero-state declarations needed by existing instrumentation."""
+from glean_parser import util
+
+def ident(value):
+    return value.replace(".", "_").replace("-", "_")
+
+def output(objs, fd):
+    def emit(s): fd.write(s + "\n")
+    def structure(name, obj):
+        typ = obj["type"]
+        if typ == "array":
+            emit(f"pub type {name} = Vec<{name}Item>;")
+            structure(name + "Item", obj["items"])
+        elif typ == "object":
+            emit("#[derive(Debug, Hash, Eq, PartialEq, Clone)]")
+            emit(f"pub struct {name} {{")
+            children = []
+            for key, val in obj["properties"].items():
+                if val["type"] in ("object", "array"):
+                    child = name + "Item" + util.Camelize(key) + ("Object" if val["type"] == "object" else "")
+                    field = f"Option<{child}>" if val["type"] == "object" else child
+                    children.append((child, val))
+                else:
+                    field = "Option<" + {"boolean":"bool", "string":"String", "number":"i64"}[val["type"]] + ">"
+                emit(f"pub r#{ident(key)}: {field},")
+            emit("}")
+            for child, val in children: structure(child, val)
+        else:
+            emit(f"pub type {name} = " + {"boolean":"bool", "string":"String", "number":"i64"}[typ] + ";")
+    emit("// No-Glean product: zero-state instrumentation compatibility only.")
+    for category, metrics in objs.items():
+        if category == "tags": continue
+        if category != "pings": emit(f"pub mod {ident(category)} {{")
+        emit("use crate::private::*;")
+        emit("use std::marker::PhantomData;")
+        for name, metric in metrics.items():
+            typ = metric.type
+            init = kind = "NullMetric"
+            if category == "pings": init = kind = "NullPing"
+            elif typ.startswith("dual_labeled_"): init = kind = "NullDualLabeledMetric"
