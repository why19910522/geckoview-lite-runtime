--- a/config/config.mk
+++ b/config/config.mk
@@ -318,6 +318,10 @@
 
 include $(MOZILLA_DIR)/config/AB_rCD.mk
 
+# Direct single-locale source builds use the pinned locale checkout.
+# Language repacks can still supply their generated merge directory.
+REAL_LOCALE_MERGEDIR ?= $(L10NBASEDIR)/$(AB_CD)
+
 # Many locales directories want this definition.
 ACDEFINES += -DAB_CD=$(AB_CD)
 
@@ -334,9 +338,7 @@
 ifdef relativesrcdir
 MAKE_JARS_FLAGS += --relativesrcdir=$(LOCALE_RELATIVEDIR)
 ifneq (en-US,$(AB_CD))
-ifdef IS_LANGUAGE_REPACK
 MAKE_JARS_FLAGS += --l10n-base=$(REAL_LOCALE_MERGEDIR)
-endif
 else
 MAKE_JARS_FLAGS += -c $(LOCALE_SRCDIR)
 endif # en-US
--- a/toolkit/locales/gen_multilocale.py
+++ b/toolkit/locales/gen_multilocale.py
@@ -7,7 +7,7 @@
 
 def main(output, *locales):
     locales = list(locales)
-    if "en-US" not in locales:
+    if not locales:
         locales.append("en-US")
 
     print(",".join(locales), file=output)
--- a/toolkit/locales/moz.build
+++ b/toolkit/locales/moz.build
@@ -10,7 +10,7 @@
 
 JAR_MANIFESTS += ["jar.mn"]
 
-GeneratedFile("multilocale.txt", script="gen_multilocale.py")
+GeneratedFile("multilocale.txt", script="gen_multilocale.py", flags=[CONFIG["MOZ_UI_LOCALE"]])
 FINAL_TARGET_FILES.res += [
     "!multilocale.txt",
 ]
--- a/toolkit/mozapps/installer/packager.mk
