+        if (!anchors[i].matches("[A-Za-z_][A-Za-z0-9_]{0,200}")) throw new IOException("Invalid native export");
+        if (offsets[i] < 0 || offsets[i] % 16384 != 0 || offsets[i] >= size) throw new IOException("Invalid native offset");
+        if (!order[i].matches("lib[A-Za-z0-9_-]+\\.so")) throw new IOException("Invalid native library name");
+      }
+      nativePreflight(order);
+      selected = new ExternalCore(id, owned, ownedLease, order, offsets, anchors);
+      Log.i("GeckoExternalCore", "SELECTED id=" + id + " pid=" + android.os.Process.myPid()
+          + " isolated=" + org.mozilla.gecko.GeckoAppShell.isIsolatedProcess());
+    } catch (final Exception | LinkageError error) {
+      try { if (ownedLease != null) ownedLease.close(); } catch (IOException ignored) { }
+      try { if (owned != null) owned.close(); } catch (IOException ignored) { }
+      throw new IllegalStateException("CORE_PREPARE_FAILED", error);
+    }
+  }
+
+  static synchronized String resourcePath(final Context context) {
+    return selected == null ? context.getPackageResourcePath() : "/proc/self/fd/" + selected.container.getFd();
+  }
+
+  static synchronized String libraryBase() {
+    if (selected == null) return null;
+    return "/proc/self/fd/" + selected.container.getFd() + "!/lib/arm64-v8a";
+  }
+
+  static synchronized void preloadDependencies() {
+    if (selected == null || selected.nativeSourcesVerified) return;
+    nativePreflight(selected.nativeLoadOrder);
+    for (int i = 0; i < selected.nativeLoadOrder.length; ++i) {
+      nativeLoad(selected.container.getFd(), selected.nativeOffsets[i], selected.nativeLoadOrder[i],
+          selected.id, selected.nativeAnchors[i]);
+    }
+    selected.nativeSourcesVerified = true;
+  }
+
+  static synchronized Bundle childExtras(final Bundle original) {
+    final Bundle result = new Bundle(original);
+    if (selected == null) return result;
+    try {
+      result.putString(ID, selected.id);
+      result.putParcelable(CORE, ParcelFileDescriptor.dup(selected.container.getFileDescriptor()));
+      result.putParcelable(LEASE, ParcelFileDescriptor.dup(selected.lease.getFileDescriptor()));
+      return result;
+    } catch (final IOException error) {
+      closeExtras(result);
+      throw new IllegalStateException("Cannot duplicate external core descriptors", error);
+    }
+  }
+
+  static void closeExtras(final Bundle extras) {
+    for (final String key : new String[] {CORE, LEASE}) {
+      final ParcelFileDescriptor pfd = extras.getParcelable(key);
+      if (pfd != null) try { pfd.close(); } catch (IOException ignored) { }
+      extras.remove(key);
+    }
+    extras.remove(ID);
+  }
+
+  static void acceptChild(final Context context, final Bundle extras) {
+    if (!extras.containsKey(ID)) return;
+    try {
+      final ParcelFileDescriptor core = extras.getParcelable(CORE);
+      final ParcelFileDescriptor lease = extras.getParcelable(LEASE);
+      if (core == null || lease == null) throw new IllegalStateException("CORE_BOOTSTRAP_MISSING");
+      prepare(context, extras.getString(ID), core, lease);
+    } finally { closeExtras(extras); }
+  }
+
+  static String[] childArgs(final Context context, final String[] original) {
+    if (!isSelected()) return original;
+    final String[] args = original.clone();
+    for (int i = 0; i + 1 < args.length; ++i) {
+      if ("-greomni".equals(args[i]) || "--greomni".equals(args[i])) {
+        args[++i] = resourcePath(context);
+      }
+    }
+    return args;
+  }
+
+  static boolean isExternalApk(final String sourceDir) {
+    try (ZipFile zip = new ZipFile(sourceDir)) {
+      return zip.getEntry("assets/" + CONTRACT) != null;
+    } catch (IOException error) {
+      throw new IllegalStateException("Cannot inspect Gecko delivery mode", error);
+    }
+  }
+}
